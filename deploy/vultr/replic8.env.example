# REPLIC8 backend settings for the Vultr server.
# Real values live only in /etc/replic8/replic8.env on the server (root:replic8, 0640).
# Never commit real values. setup.sh fills in the two tokens and the allowed hosts.

# Where clones, builds, the registry and the event log live.
REPLIC8_DATA_DIR=/var/lib/replic8

# Agents, the dashboard and MCP clients use a gateway token. Admin tokens can
# onboard, repair and roll back; keep them off the frontend.
REPLIC8_GATEWAY_TOKENS=
REPLIC8_ADMIN_TOKENS=

# Which tools each gateway token may call: <token id>=ns.*|ns.tool,<id2>=...
# The token id is the first 12 hex characters of the token's SHA-256. A gateway
# token with no entry can call nothing. setup.sh scopes its token to both demo systems.
REPLIC8_TOKEN_SCOPES=

# The sandbox runs only digest-pinned images. setup.sh writes the runtime image's
# pinned reference here after every build.
REPLIC8_SANDBOX_IMAGES=

# Nemotron (onboarding and self-heal). Without a key, published tools still work.
NVIDIA_API_KEY=
REPLIC8_NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# The Vercel site's exact origin(s), comma-separated, e.g. https://replic8.vercel.app
REPLIC8_CORS_ORIGINS=

# Host names the MCP endpoint accepts (setup.sh sets your domain here).
REPLIC8_ALLOWED_HOSTS=

# Demo legacy systems ship in this repo (legacy/). Onboard them as local://<folder>.
REPLIC8_LOCAL_REPO_ROOT=/opt/replic8/legacy

# Check legacy repos for changes every N seconds (0 = off; at least 30).
REPLIC8_POLL_SECONDS=0

# Parser grammars pre-downloaded by setup.sh (must be owned by the service user).
TREE_SITTER_LANGUAGE_PACK_CACHE_DIR=/var/lib/replic8/grammars

# Caddy is the only public listener; the app stays on localhost.
REPLIC8_HOST=127.0.0.1
REPLIC8_PORT=8000
