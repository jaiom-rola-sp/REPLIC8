# Copy to .env and fill in. Git ignores .env, but not this template, so keep real values out of it.
# Make a token with:  python -c "import secrets; print(secrets.token_hex(24))"   (at least 32 characters)

REPLIC8_GATEWAY_TOKENS=
REPLIC8_ADMIN_TOKENS=
# Which tools each gateway token may call: <token id>=<scope>|<scope>, comma-separated.
# Token id = first 12 hex characters of the token's SHA-256 (also shown in the audit log):
#   python -c "import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest()[:12])" <token>
# A scope is ns.* or ns.tool. A token with no entry can call nothing. Admins can grant or
# remove scopes at runtime with POST/DELETE /v1/admin/scopes; this line is the starting set.
# Example (replace 0123456789ab with your gateway token's id; unknown ids stop startup):
#   REPLIC8_TOKEN_SCOPES=0123456789ab=maintenance.*|inventory.*
REPLIC8_TOKEN_SCOPES=
NVIDIA_API_KEY=
REPLIC8_NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
