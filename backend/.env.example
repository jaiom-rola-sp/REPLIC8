# Copy to .env and fill in. Git ignores .env, but not this template, so keep real values out of it.
# Make a token with:  python -c "import secrets; print(secrets.token_hex(24))"   (at least 32 characters)

REPLIC8_GATEWAY_TOKENS=
REPLIC8_ADMIN_TOKENS=

# Gateway tokens are fail-closed: a token with no scopes sees and calls nothing, and the
# dashboard looks empty. Give each gateway token its systems as <token id>=ns.*|ns.tool.
# The token id is the first 12 hex characters of the token's SHA-256:
#   python -c "import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest()[:12])" <token>
# Keep the single quotes if a shell loads this file (the | would otherwise be a pipe).
# This is the starting set. To give a token a system imported later from the dashboard, an admin
# can grant it without a restart: POST /v1/admin/scopes {"token_id", "scope"} (DELETE removes one).
REPLIC8_TOKEN_SCOPES='<token id>=maintenance.*|inventory.*'

# Demo legacy systems in this repo, onboarded as local://<folder>. Leave unset to allow GitHub only.
REPLIC8_LOCAL_REPO_ROOT=../legacy
NVIDIA_API_KEY=
REPLIC8_NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
